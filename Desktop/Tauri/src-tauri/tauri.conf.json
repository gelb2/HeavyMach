{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heavy Mach Desktop",
  "version": "0.17.0",
  "identifier": "com.gelb2.heavymach.desktop",
  "build": {
    "frontendDist": "../build/frontend",
    "beforeBuildCommand": "python3 scripts/prepare.py --skip-build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "../build/icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
